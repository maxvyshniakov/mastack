{
  "comment": "release guard: releases and publishes (npm/bun/pnpm/yarn publish, bun run release:publish, repo-kit release, gh release create, pushing a v* tag, lanefather promote --ship) are refused unless the environment carries an explicit owner go-ahead in MASTACK_RELEASE_OK naming what may be released. On 2026-11-12 an agent published repo-kit 0.6.0 against its brief. Deny cases run without MASTACK_RELEASE_OK (or with MASTACK_RELEASE_OK set in the command itself); allow cases are non-release commands, dry runs, help and everyday promotions. Owner-only cases (owner_only: true) change visibility, access or Pages: the variable does not cover them, and the refusal must not offer it. Review 2026-11-24 (F3-F5, F12): ordinary spellings of the same actions, mixed-case workflow names and quote-split words, which bash_guard's prefilter must still route here.",
  "deny": [
    {"name": "npm publish", "command": "npm publish"},
    {"name": "npm publish with access flag", "command": "npm publish --access public"},
    {"name": "bun publish", "command": "bun publish"},
    {"name": "pnpm publish", "command": "pnpm publish --no-git-checks"},
    {"name": "yarn npm publish", "command": "yarn npm publish --access public"},
    {"name": "bun run release:publish", "command": "bun run release:publish"},
    {"name": "npm run release:publish", "command": "npm run release:publish"},
    {"name": "repo-kit release", "command": "repo-kit release -- ui-kit:patch"},
    {"name": "bunx repo-kit release", "command": "bunx repo-kit release ui-kit:minor"},
    {"name": "npx scoped repo-kit release", "command": "npx @scope/repo-kit release app:1.2.0"},
    {"name": "gh release create", "command": "gh release create v1.2.0 --generate-notes"},
    {"name": "gh release create with repo option", "command": "gh release create -R acme/app v1.2.0 --title 'v1.2.0'"},
    {"name": "git push a v* tag", "command": "git push origin v1.2.0"},
    {"name": "git push refs/tags/v*", "command": "git push origin refs/tags/v0.6.0"},
    {"name": "git push a SHA to refs/tags/v*", "command": "git push origin d52ab67d:refs/heads/main d52ab67d:refs/tags/v0.6.0"},
    {"name": "git push --tags", "command": "git push origin --tags"},
    {"name": "lanefather promote --ship", "command": "lanefather promote d52ab67d --ship"},
    {"name": "lanefather --config promote --ship", "command": "lanefather --config /tmp/project.toml promote d52ab67d --ship"},
    {"name": "inside a chain after &&", "command": "bun run verify && bun run release:publish"},
    {"name": "inside sh -c", "command": "sh -c 'cd /tmp && npm publish'"},
    {"name": "inside bash -lc", "command": "bash -lc 'repo-kit release ui-kit:patch && bun run release:publish'"},
    {"name": "inside a command substitution", "command": "out=$(gh release create v1.2.0 --notes 'ok') && echo \"$out\""},
    {"name": "agent setting MASTACK_RELEASE_OK inline", "command": "MASTACK_RELEASE_OK=@acme/app@1.2.0 bun run release:publish"},
    {"name": "agent setting MASTACK_RELEASE_OK via env", "command": "env MASTACK_RELEASE_OK=@acme/app@1.2.0 npm publish"},
    {"name": "agent exporting MASTACK_RELEASE_OK in chain", "command": "export MASTACK_RELEASE_OK=@acme/app@1.2.0 && bun publish"},
    {"name": "gh repo edit visibility", "command": "gh repo edit --visibility public --accept-visibility-change-consequences", "owner_only": true},
    {"name": "gh repo edit visibility equals form", "command": "gh repo edit --visibility=public", "owner_only": true},
    {"name": "gh repo create public", "command": "gh repo create acme/new --public", "owner_only": true},
    {"name": "gh repo create public=true", "command": "gh repo create acme/new --public=true", "owner_only": true},
    {"name": "gh api repository private=false", "command": "gh api -X PATCH repos/acme/grid -F private=false", "owner_only": true},
    {"name": "gh api repository visibility", "command": "gh api -X PATCH repos/acme/grid -f visibility=public", "owner_only": true},
    {"name": "gh api repository visibility, fields imply a write", "command": "gh api repos/acme/grid -f visibility=public", "owner_only": true},
    {"name": "gh api pages, attached short flags", "command": "gh api -XPOST repos/acme/grid/pages -fbuild_type=workflow", "owner_only": true},
    {"name": "gh api pages with a query string", "command": "gh api -X POST 'repos/acme/grid/pages?x=1' -f build_type=workflow", "owner_only": true},
    {"name": "gh api pages, last method wins", "command": "gh api -X GET -X DELETE repos/acme/grid/pages", "owner_only": true},
    {"name": "gh api pages, method equals form", "command": "gh api --method=DELETE /repos/acme/grid/pages", "owner_only": true},
    {"name": "npm access set", "command": "npm access set status=public @acme/grid", "owner_only": true},
    {"name": "npm config set access", "command": "npm config set access public", "owner_only": true},
    {"name": "npm config set access equals form", "command": "npm config set access=public", "owner_only": true},
    {"name": "npm pkg set publishConfig.access", "command": "npm pkg set publishConfig.access=public", "owner_only": true},
    {"name": "npm_config_access in the environment", "command": "npm_config_access=public npm publish", "owner_only": true},
    {"name": "quote-split npm access", "command": "npm ac''cess set status=public @acme/grid", "owner_only": true},
    {"name": "quote-split gh repo visibility", "command": "gh repo edit --vis''ibility public", "owner_only": true},
    {"name": "quote-split gh api pages", "command": "gh api -X POST repos/acme/grid/pa''ges -f build_type=workflow", "owner_only": true},
    {"name": "gh workflow run release workflow", "command": "gh workflow run release-npm.yml --ref main"},
    {"name": "gh workflow run mixed-case Release", "command": "gh workflow run Release.yml --ref main"},
    {"name": "gh workflow run mixed-case Publish", "command": "gh workflow run Publish.yml --ref main"},
    {"name": "gh workflow run promote workflow", "command": "gh workflow run promote.yml"},
    {"name": "gh workflow run by numeric id", "command": "gh workflow run 12345678"},
    {"name": "gh api release creation", "command": "gh api -X POST repos/acme/grid/releases -f tag_name=v2.0.0"},
    {"name": "gh api workflow dispatch", "command": "gh api -X POST repos/acme/grid/actions/workflows/release-npm.yml/dispatches -f ref=main"},
    {"name": "release:publish with access", "command": "bun run release:publish -- --access public"},
    {"name": "publish, last access flag wins", "command": "npm publish --access restricted --access public"},
    {"name": "two tags in one push", "command": "git push origin v1.2.1 v2.0.0"},
    {"name": "push --follow-tags", "command": "git push --follow-tags origin HEAD:refs/heads/main"},
    {"name": "push.followTags config", "command": "git -c push.followTags=true push origin HEAD:refs/heads/main"},
    {"name": "glob tag refspec", "command": "git push origin 'refs/tags/v*'"},
    {"name": "uppercase V tag", "command": "git push origin refs/tags/V2.0.0"},
    {"name": "npm run with an option before the script", "command": "npm run --silent release:publish"},
    {"name": "bun run with an option before the script", "command": "bun run --silent release:publish"},
    {"name": "npm run-script", "command": "npm run-script release:publish"},
    {"name": "pnpm run --if-present", "command": "pnpm run --if-present release:publish"},
    {"name": "pnpm dlx --package repo-kit", "command": "pnpm dlx --package @acme/repo-kit repo-kit release grid:major"},
    {"name": "bunx package-kit release", "command": "bunx package-kit release grid:major"},
    {"name": "bunx package-kit publish", "command": "bunx package-kit publish"},
    {"name": "quote-split publish", "command": "npm pub''lish"},
    {"name": "quote-split push", "command": "git pu''sh origin v2.0.0"},
    {"name": "command substitution with case the reader cannot parse", "command": "echo $(case x in x) echo ok;; esac) && npm publish"},
    {"name": "heredoc holding a parenthesis", "command": "cat <<'END-1' >/dev/null && npm publish\n(\nEND-1"}
  ],
  "allow": [
    {"name": "npm publish --dry-run", "command": "npm publish --dry-run"},
    {"name": "bun publish --dry-run", "command": "bun publish --dry-run"},
    {"name": "pnpm publish --dry-run", "command": "pnpm publish --dry-run"},
    {"name": "npm publish --help", "command": "npm publish --help"},
    {"name": "repo-kit release-gate", "command": "bunx repo-kit release-gate origin/main"},
    {"name": "repo-kit verify", "command": "bunx repo-kit verify --release"},
    {"name": "gh release view and list", "command": "gh release list && gh release view v1.2.0"},
    {"name": "git push to dev by SHA", "command": "git push origin d52ab67d:refs/heads/dev"},
    {"name": "git push a lane branch", "command": "git push -u origin lane/12-release-guard"},
    {"name": "git push deleting a tag", "command": "git push origin --delete v1.2.0"},
    {"name": "git push :refs/tags/v*", "command": "git push origin :refs/tags/v1.2.0"},
    {"name": "git push --dry-run of a tag", "command": "git push --dry-run origin v1.2.0"},
    {"name": "git tag locally", "command": "git tag -a v1.2.0 -m 'v1.2.0'"},
    {"name": "lanefather promote without --ship", "command": "lanefather promote d52ab67d"},
    {"name": "lanefather promote --help", "command": "lanefather promote --help"},
    {"name": "bun run build and test", "command": "bun run build && bun run test"},
    {"name": "quoted mention", "command": "echo 'run npm publish or bun run release:publish'"},
    {"name": "gh workflow run check workflow", "command": "gh workflow run check.yml --ref main -f force=true"},
    {"name": "gh api pages read", "command": "gh api repos/acme/grid/pages"},
    {"name": "gh api repository read", "command": "gh api repos/acme/grid --jq .visibility"},
    {"name": "gh repo edit description", "command": "gh repo edit --description 'Data grid'"},
    {"name": "gh repo create private", "command": "gh repo create acme/new --private"},
    {"name": "npm access get", "command": "npm access get status @acme/grid"},
    {"name": "npm config get access", "command": "npm config get access"},
    {"name": "npm pkg get", "command": "npm pkg get publishConfig.access"},
    {"name": "release gate", "command": "bun run release:gate -- origin/main"},
    {"name": "push to main by sha", "command": "git push origin d52ab67d:refs/heads/main"},
    {"name": "unreadable command without a release word", "command": "echo $(case x in x) echo ok;; esac)"}
  ]
}

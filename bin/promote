#!/usr/bin/env bash
# Ask the release workflow on main to publish this exact dev commit.
set -eu
number='(0|[1-9][0-9]*)'
if [[ $# != 1 || ! $1 =~ ^${number}\.${number}\.${number}$ ]]; then
  echo 'usage: bin/promote X.Y.Z' >&2
  exit 2
fi
sha=$(git rev-parse HEAD)
repo=$(gh repo view "$(git remote get-url origin)" --json nameWithOwner --jq .nameWithOwner)
[[ $(git ls-remote origin refs/heads/dev | cut -f1) == "$sha" ]] || {
  echo 'Run from the published dev commit.' >&2
  exit 1
}
gh workflow run promote.yml --repo "$repo" --ref main -f source="$sha" -f version="$1"

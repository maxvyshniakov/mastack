#!/usr/bin/env python3
"""Emit verified mechanical fields of an implementer lane report from git state.

    bin/lane-receipt [--base REF] [--claims GLOB...] [--json]
"""
from __future__ import annotations

import argparse
import fnmatch
import json
import os
import subprocess
import sys


def git(*args: str) -> str:
    return subprocess.check_output(["git", *args], text=True, stderr=subprocess.DEVNULL).strip()


def default_base() -> str:
    for ref in ("origin/main", "main"):
        try:
            return git("merge-base", ref, "HEAD")
        except subprocess.CalledProcessError:
            continue
    return "HEAD~1"


def matches_any(path: str, globs: list[str]) -> bool:
    for pattern in globs:
        if fnmatch.fnmatch(path, pattern):
            return True
        if pattern.endswith("/**") and path.startswith(pattern[:-2]):
            return True
        if pattern.endswith("/") and path.startswith(pattern):
            return True
    return False


def is_test_file(path: str) -> bool:
    name = os.path.basename(path)
    return (name.startswith("test_") or "_test." in name or ".test." in name or ".spec." in name
            or path.startswith("tests/"))


def diff_paths(base: str, extra: list[str] = ()) -> list[str]:
    out = subprocess.check_output(
        ["git", "-c", "core.quotePath=false", "diff", "-z", "--name-only", *extra, f"{base}...HEAD"],
        stderr=subprocess.PIPE,
    )
    return [p.decode("utf-8", "replace") for p in out.split(b"\0") if p]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--base", help="base ref for diffing changed files (default: merge-base with origin/main or main)")
    parser.add_argument("--claims", nargs="*", default=[], help="claimed path globs")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    try:
        branch = git("rev-parse", "--abbrev-ref", "HEAD")
        sha = git("rev-parse", "--short=7", "HEAD")
        worktree = os.path.realpath(git("rev-parse", "--show-toplevel"))
    except subprocess.CalledProcessError:
        sys.stderr.write("lane-receipt: not inside a git worktree\n")
        return 2

    base = args.base or default_base()
    try:
        changed = diff_paths(base)
    except subprocess.CalledProcessError as error:
        sys.stderr.write(f"lane-receipt: cannot diff against {base!r}: {error.stderr.decode('utf-8', 'replace').strip()}\n")
        return 2

    outside = [p for p in changed if args.claims and not matches_any(p, args.claims)]
    new_tests = [p for p in changed if is_test_file(p)]

    data = {
        "branch": branch,
        "sha": sha,
        "base": base,
        "worktree": worktree,
        "changed": changed,
        "outside_claims": outside,
        "new_tests": new_tests,
    }
    if args.json:
        print(json.dumps(data, indent=2))
    else:
        print(f"Branch: {branch}")
        print(f"SHA: {sha}")
        print(f"Worktree: {worktree}")
        print(f"Outside claims: {', '.join(outside) if outside else 'none'}")
        if new_tests:
            formatted = "; ".join(f"{p}: <count>, <layer>, <seconds>" for p in new_tests)
            print(f"New tests: {formatted}")
        else:
            print("New tests: none")
    return 0


if __name__ == "__main__":
    sys.exit(main())

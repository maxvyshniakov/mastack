#!/usr/bin/env python3
"""Cross-harness PATH shim dispatcher: runs hooks/bash_guard.decide() before exec'ing the real binary.

Installed via `bin/install-shims`. Each shim invokes:
    exec python3 <mastack>/bin/shim-exec <shim-dir> <program> "$@"
"""
from __future__ import annotations

import os
import shlex
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "hooks"))

import bash_guard  # noqa: E402

SHIM_MARKER = "# mastack-shim"


def is_mastack_shim(path: str) -> bool:
    try:
        with open(path, "rb") as handle:
            head = handle.read(256)
        return SHIM_MARKER.encode() in head
    except OSError:
        return False


def find_real(program: str, shim_dir: str) -> str | None:
    shim_real = os.path.realpath(shim_dir)
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        if not entry or os.path.realpath(entry) == shim_real:
            continue
        candidate = os.path.join(entry, program)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK) and not is_mastack_shim(candidate):
            return candidate
    return None


def main() -> int:
    if len(sys.argv) < 3:
        sys.stderr.write("shim-exec: usage: shim-exec <shim-dir> <program> [args...]\n")
        return 2
    shim_dir, program, args = sys.argv[1], sys.argv[2], sys.argv[3:]
    command = shlex.join([program, *args])
    payload = {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "cwd": os.getcwd(),
        "tool_input": {"command": command},
    }
    # A shim cannot tell whether MASTACK_RELEASE_OK came from the owner's shell or from
    # an agent-typed `MASTACK_RELEASE_OK=... <cmd>` prefix, so fail closed on it.
    saved_release_ok = os.environ.pop("MASTACK_RELEASE_OK", None)
    try:
        decision = bash_guard.decide(payload)
    finally:
        if saved_release_ok is not None:
            os.environ["MASTACK_RELEASE_OK"] = saved_release_ok
    if decision is not None:
        kind = decision.decision[0] if hasattr(decision, "decision") and decision.decision else decision[0]
        reason = decision.decision[1] if hasattr(decision, "decision") and decision.decision else decision[1]
        if kind in ("deny", "ask"):
            sys.stderr.write(f"mastack shim ({kind}): {reason}\n")
            return 126
    real = find_real(program, shim_dir)
    if not real:
        sys.stderr.write(f"shim-exec: {program}: command not found\n")
        return 127
    os.execv(real, [program, *args])
    return 127


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""Which model takes a role now, by models.toml and any live quotas its conditions name.

    bin/role <role> [--implementer-family F] [--family F] [--exclude-family F] [--pair] [--json]

Takes the role's first choice whose conditions hold (`when.limit`, `when.not_family`, the role's `only_families`)
and prints its model, id, family and effort, each headless command of its `[cli.*]` with {id} and {effort} filled
(or its `delegate_task` target and option for Antigravity / T3 Code), its note, and why every earlier choice was
skipped. With `--pair`, resolves a `(primary, partner)` pair from two distinct active families (exiting 1 if fewer
than two families qualify).
`--implementer-family` is the family of the model whose work is reviewed; `not_family` is not met without it.
`--family` restricts selection to one provider family (e.g. `google`, `anthropic`); `--exclude-family`
(repeatable) skips families whose quota is exhausted or unavailable.

MASTACK_MODELS names another table; MASTACK_CODEX another Codex CLI than `codex` on PATH.

Exit 0 with a choice (or pair), 1 when no choice (or second family for `--pair`) qualifies, 2 when the table or the
role cannot be read.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))

import model_roles  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("role", nargs="?")
    parser.add_argument("--implementer-family", metavar="F", help="family of the implementer, e.g. anthropic")
    parser.add_argument("--family", metavar="F", help="limit selection to one family, e.g. google")
    parser.add_argument("--exclude-family", metavar="F", action="append", default=[],
                        help="skip choices from family F (repeatable)")
    parser.add_argument("--harness", choices=("auto", "claude", "codex", "t3"), default="auto",
                        help="target harness for launch output (filters incompatible choices)")
    parser.add_argument("--cooldown", nargs=2, metavar=("FAMILY", "DURATION"),
                        help="mark FAMILY unavailable for DURATION (e.g. 2h, 30m, 0 to clear)")
    parser.add_argument("--pair", action="store_true",
                        help="resolve a (primary, partner) pair from two distinct active families")
    parser.add_argument("--json", action="store_true", help="print the answer as JSON")
    args = parser.parse_args()
    if args.cooldown:
        fam, dur = args.cooldown
        try:
            table = model_roles.load()
            until = model_roles.set_cooldown(fam, dur, table=table)
        except (ValueError, model_roles.TableError) as error:
            print(f"role: {error}", file=sys.stderr)
            return 2
        if until is None:
            print(f"cooldown cleared: {fam}")
        else:
            print(f"cooldown set: {fam} until {int(until)}")
        if not args.role:
            return 0
    if not args.role:
        parser.error("the following arguments are required: role")
    try:
        table = model_roles.load()
        if args.pair:
            primary, partner, skipped, quotas = model_roles.resolve_pair(
                table, args.role, args.implementer_family,
                family=args.family, exclude_families=args.exclude_family,
                harness=args.harness,
            )
        else:
            choice, skipped, quotas = model_roles.resolve(
                table, args.role, args.implementer_family,
                family=args.family, exclude_families=args.exclude_family,
                harness=args.harness,
            )
    except model_roles.TableError as error:
        print(f"role: {error}", file=sys.stderr)
        return 2
    if args.pair:
        if args.json:
            print(json.dumps(model_roles.as_pair_json(args.role, primary, partner, skipped, quotas,
                                                      harness=args.harness), indent=2))
        else:
            print(model_roles.describe_pair(args.role, primary, partner, skipped, harness=args.harness))
        return 0 if (primary and partner) else 1
    if args.json:
        print(json.dumps(model_roles.as_json(args.role, choice, skipped, quotas, harness=args.harness), indent=2))
    else:
        print(model_roles.describe(args.role, choice, skipped, harness=args.harness))
    return 0 if choice else 1


if __name__ == "__main__":
    sys.exit(main())

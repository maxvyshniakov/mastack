#!/usr/bin/env python3
"""Cap oversized command output before it enters an agent's context.

    bin/quiet-cap [--max-chars 8000] -- <command...>

When combined stdout+stderr stays within --max-chars, prints it verbatim.
Otherwise writes the full output to a temp log file and prints a strictly
bounded summary (<= --max-chars plus the log footer) with head, error/FAIL
lines, and tail, preserving the command's exit code.
"""
from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
import tempfile

ERROR_RE = re.compile(r"(?i)(?:error|fail(?:ed|ure)?|traceback|exception|panic|assert)")


def summarize(text: str, log_path: str, max_chars: int) -> str:
    footer = f"\n... [capped at {max_chars} chars from {len(text)}; full output: {log_path}] ...\n"
    budget = max(200, max_chars - len(footer))
    lines = text.splitlines()
    if len(lines) > 100:
        head_text = "\n".join(l[:200] for l in lines[:40])
        tail_text = "\n".join(l[:200] for l in lines[-60:])
        errors = [line[:200] for line in lines[40:-60] if ERROR_RE.search(line)][:20]
        err_block = ("\n... [matching error/FAIL lines] ...\n" + "\n".join(errors) + "\n") if errors else "\n...\n"
        if len(err_block) > budget // 2:
            err_block = err_block[:budget // 2] + "\n"
        rem = max(0, budget - len(err_block))
        half = rem // 2
        candidate = head_text[:half] + err_block + tail_text[-half:]
    elif len(text) > budget:
        half = budget // 2
        candidate = text[:half] + "\n...\n" + text[-half:]
    else:
        candidate = text
    return candidate + footer


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--max-chars", type=int, default=8000)
    parser.add_argument("cmd", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    cmd = args.cmd[1:] if args.cmd and args.cmd[0] == "--" else args.cmd
    if not cmd:
        parser.error("missing command after --")
    try:
        proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    except FileNotFoundError:
        sys.stderr.write(f"quiet-cap: {cmd[0]}: command not found\n")
        return 127
    raw = proc.stdout or b""
    out = raw.decode("utf-8", "replace")
    if len(out) <= args.max_chars:
        sys.stdout.write(out)
    else:
        fd, log_path = tempfile.mkstemp(prefix=f"mastack-out-{os.getpid()}-", suffix=".log")
        with os.fdopen(fd, "wb") as handle:
            handle.write(raw)
        sys.stdout.write(summarize(out, log_path, args.max_chars))
    return proc.returncode


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env bash
# Install cross-harness PATH shims so bash_guard protects Codex and Antigravity / T3 Code.
#
#   bin/install-shims [--dir DIR] [--uninstall]
#
# Default DIR: ~/.local/share/mastack/shims ($XDG_DATA_HOME/mastack/shims).
# Prepend DIR to PATH in agent sessions so git, gh, npm, bun, pnpm, codex, pkill,
# and killall run through hooks/bash_guard.py before exec'ing the real binary.
# (Note: `kill` is a shell builtin in bash/zsh/sh and is not intercepted via PATH.)
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd -P)
dir=${XDG_DATA_HOME:-$HOME/.local/share}/mastack/shims
uninstall=0
PROGRAMS=(git gh npm bun pnpm codex pkill killall)

while (($#)); do
  case $1 in
    --dir) dir=${2:?--dir needs a directory}; shift ;;
    --uninstall) uninstall=1 ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "install-shims: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

is_ours() { [[ -f $1 && ! -L $1 ]] && grep -q '^# mastack-shim$' "$1"; }

if ((uninstall)); then
  if [[ -d $dir ]]; then
    for prog in "${PROGRAMS[@]}"; do
      is_ours "$dir/$prog" && rm -f "$dir/$prog"
    done
  fi
  echo "install-shims: removed mastack shims from $dir"
  exit 0
fi

mkdir -p "$dir"
dir=$(cd "$dir" && pwd -P)
for prog in "${PROGRAMS[@]}"; do
  dest=$dir/$prog
  if [[ -e $dest || -L $dest ]] && ! is_ours "$dest"; then
    echo "install-shims: refusing to overwrite foreign file $dest" >&2
    exit 1
  fi
  rm -f "$dest"
  cat > "$dest" <<SH
#!/usr/bin/env bash
# mastack-shim
exec python3 "$root/bin/shim-exec" "$dir" "$prog" "\$@"
SH
  chmod +x "$dest"
done
echo "install-shims: installed ${#PROGRAMS[@]} shims in $dir"
